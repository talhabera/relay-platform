{
  "name": "relay",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.11.0",
  "scripts": {
    "dev": "turbo run dev --filter=@relay/web --filter=@relay/worker",
    "dev:web": "pnpm --filter @relay/web dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @relay/db generate",
    "db:migrate": "pnpm --filter @relay/db migrate",
    "db:push": "pnpm --filter @relay/db push",
    "db:studio": "pnpm --filter @relay/db studio",
    "db:seed": "pnpm --filter @relay/web seed"
  },
  "devDependencies": {
    "turbo": "^2.5.8",
    "typescript": "^5"
  }
}
